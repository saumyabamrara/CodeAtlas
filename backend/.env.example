# Application metadata
APP_NAME=CodeAtlas Backend
APP_VERSION=0.1.0
API_V1_PREFIX=

# Logging
LOG_LEVEL=INFO

# JSON array of browser origins permitted during local development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Directory where cloned repositories are stored (defaults to backend/workspace)
REPOSITORY_WORKSPACE=workspace

# JavaParser bridge configuration
JAVA_PARSER_RUNNER_JAR=java_parser/target/codeatlas-java-parser-runner.jar
JAVA_EXECUTABLE=java

# Server-side AI architecture assistant configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
